{
  "name": "iobroker.botslab360",
  "version": "0.3.0",
  "description": "Adapter for Botslab 360 Vacuum",
  "author": {
    "name": "TA2k",
    "email": "tombox2020@gmail.com"
  },
  "homepage": "https://github.com/TA2k/ioBroker.botslab360",
  "license": "MIT",
  "keywords": [
    "360",
    "Vacuum",
    "botslab"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TA2k/ioBroker.botslab360.git"
  },
  "engines": {
    "node": ">= 14"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.20.0",
    "jscrypto": "^1.0.3",
    "json2iob": "^2.6.26"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iobroker/testing": "^6.2.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint .",
    "translate": "translate-adapter"
  },
  "bugs": {
    "url": "https://github.com/TA2k/ioBroker.botslab360/issues"
  },
  "readmeFilename": "README.md"
}
